<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof mermaid !== "undefined") {
      mermaid.initialize({
        startOnLoad: false,
        theme: "default",
        flowchart: {
          useMaxWidth: false,
          htmlLabels: true,
          nodeSpacing: 30,
          rankSpacing: 50,
          curve: "basis",
        },
        themeVariables: {
          fontSize: "16px",
          fontFamily: "IBM Plex Sans, sans-serif",
        },
      });

      const diagrams = {
        "mermaid-da": `flowchart TB
    A["📊 Datos crudos"]:::fuente --> B["🔍 Análisis exploratorio"]:::model
    B --> C["💡 Hallazgos clave"]:::out
    C --> D["📈 Visualización clara"]:::ui
    D --> E["📋 Recomendación"]:::proc
    E --> F["✅ Decisión operativa"]:::riesgo

    classDef fuente fill:#EAB308,stroke:#A16207,color:#1F2937,stroke-width:2px;
    classDef proc   fill:#3B82F6,stroke:#1D4ED8,color:#FFFFFF,stroke-width:2px;
    classDef model  fill:#22C55E,stroke:#15803D,color:#06310F,stroke-width:2px;
    classDef out    fill:#8B5CF6,stroke:#6D28D9,color:#FFFFFF,stroke-width:2px;
    classDef riesgo fill:#EF4444,stroke:#B91C1C,color:#FFFFFF,stroke-width:2px;
    classDef ui     fill:#64748B,stroke:#334155,color:#FFFFFF,stroke-width:2px;`,

        "mermaid-ds": `flowchart TB
    A["⚙️ Feature engineering"]:::fuente --> B["🤖 Modelo entrenado"]:::model
    B --> C["❌ Métricas de error"]:::riesgo
    C --> D["💰 Costo económico"]:::proc
    D --> E["📖 Narrativa de impacto"]:::out
    E --> F["🎯 Calibración del umbral"]:::ui

    classDef fuente fill:#EAB308,stroke:#A16207,color:#1F2937,stroke-width:2px;
    classDef proc   fill:#3B82F6,stroke:#1D4ED8,color:#FFFFFF,stroke-width:2px;
    classDef model  fill:#22C55E,stroke:#15803D,color:#06310F,stroke-width:2px;
    classDef out    fill:#8B5CF6,stroke:#6D28D9,color:#FFFFFF,stroke-width:2px;
    classDef riesgo fill:#EF4444,stroke:#B91C1C,color:#FFFFFF,stroke-width:2px;
    classDef ui     fill:#64748B,stroke:#334155,color:#FFFFFF,stroke-width:2px;`,
      };

      Object.entries(diagrams).forEach(([id, definition]) => {
        const container = document.getElementById(id);
        if (container) {
          mermaid.render(`mermaid-svg-${id}`, definition).then(({ svg }) => {
            container.innerHTML = svg;
          });
        }
      });
    }
  });
</script>
