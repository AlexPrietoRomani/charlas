          style="font-size:clamp(2.5rem, 5vw, 4rem); text-transform:uppercase; letter-spacing:0.04em; line-height:1.1; color:#FFFFFF;"
        >
          Gracias
        </h1>
        <div style="width:60px; height:2px; background:var(--accent-frost);">
        </div>
        <p
          class="body"
          style="color:var(--text-dark-mute); max-width:none; text-align:center; font-size:1.1rem; line-height:1.6;"
        >
          Alex Prieto Romani<br />
          Ingeniero Agrónomo · Data Scientist
        </p>
        <div
          style="display:flex; flex-direction:column; gap:0.8rem; margin-top:0.5rem;"
        >
          <a
            href="https://alexprietoromani.github.io/"
            target="_blank"
            style="color:var(--accent-frost); text-decoration:none; font-family:'IBM Plex Mono',monospace; font-size:0.95rem; display:flex; align-items:center; gap:8px;"
          >
            <span style="font-size:1.2rem;">🌐</span> alexprietoromani.github.io
          </a>
          <a
            href="https://www.linkedin.com/in/alexprietoromani/"
            target="_blank"
            style="color:var(--accent-frost); text-decoration:none; font-family:'IBM Plex Mono',monospace; font-size:0.95rem; display:flex; align-items:center; gap:8px;"
          >
            <span style="font-size:1.2rem;">💼</span> linkedin.com/in/alexprietoromani
          </a>
          <a
            href="https://github.com/AlexPrietoRomani"
            target="_blank"
            style="color:var(--accent-frost); text-decoration:none; font-family:'IBM Plex Mono',monospace; font-size:0.95rem; display:flex; align-items:center; gap:8px;"
          >
            <span style="font-size:1.2rem;">💻</span> github.com/AlexPrietoRomani
          </a>
          <a
            href="mailto:alexprieto1997@gmail.com"
            style="color:var(--accent-frost); text-decoration:none; font-family:'IBM Plex Mono',monospace; font-size:0.95rem; display:flex; align-items:center; gap:8px;"
          >
            <span style="font-size:1.2rem;">✉️</span> alexprieto1997@gmail.com
          </a>
        </div>
        <p
          class="body"
          style="color:var(--text-dark-faint); font-size:0.8rem; margin-top:1rem; font-style:italic;"
        >
          "Decidir con datos no es acertar siempre. Es elegir con qué error
          puedes vivir."
        </p>
      </div>
      <footer>Presentado por Alex Prieto · 2026</footer>
    </section>
  </div>

  <div class="chrome">
    <button class="navbtn" id="prevBtn" aria-label="Anterior">‹</button>
    <span class="counter"
      ><b id="curNum">1</b> / <span id="totNum">20</span></span
    >
    <button class="navbtn" id="nextBtn" aria-label="Siguiente">›</button>
  </div>
</Layout>

<script>
  // @ts-nocheck
  // Declare Leaflet, PapaParse, and Chart as globals from CDN
  const Papa = window.Papa;
  const Chart = window.Chart;
  const L = window.L;

  const UMBRAL_ACTIVACION = 2.0; // proteger si pronostico <= este valor
  const UMBRAL_DANO = -0.5; // helada daniña si observado <= este valor
  const COSTO_NOCHE = 340; // USD por noche de proteccion antihelada
  const C = {
    night: "#0B1120",
    frost: "#67E8F9",
    amber: "#FBBF24",
    red: "#FB4A5A",
    green: "#34D399",
    mute: "#8A9AB0",
    line: "rgba(233,238,246,.10)",
  };

  const esT = (n) =>
    n.toLocaleString("es-CL", {
      minimumFractionDigits: 1,
      maximumFractionDigits: 1,
    }) + " °C";
  const esUSD = (n) => "US$ " + Math.round(n).toLocaleString("es-CL");
  const reduce = window.matchMedia("(prefers-reduced-motion:reduce)").matches;

  async function loadCSV(name) {
    const res = await fetch(name, { cache: "no-store" });
    if (!res.ok) throw new Error("Fetch failed for " + name);
    const txt = await res.text();
    if (!txt.trim().length) throw new Error("Empty text");
    return Papa.parse(txt.trim(), {
      header: true,
      dynamicTyping: true,
      skipEmptyLines: true,
    }).data;
  }

  function classify(row, thr) {
    const flagged = row.temp_min_pronostico_c <= thr;
    const frost = row.temp_min_obs_c <= UMBRAL_DANO;
    if (flagged && frost) return "tp";
    if (flagged && !frost) return "fp";
    if (!flagged && frost) return "fn";
    return "tn";
  }

  function tally(rows, thr) {
    const t = { tp: 0, tn: 0, fp: 0, fn: 0 };
    rows.forEach((r) => t[classify(r, thr)]++);
    return t;
  }

  let clima = [],
    rend = [],
    charts = {};

  function countUp(el, target, fmt, dur = 1100) {
    if (reduce) {
      el.textContent = fmt(target);
      return;
    }
    const t0 = performance.now();
    function step(now) {
      const p = Math.min(1, (now - t0) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(target * e);
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  function buildStatics() {
    const base = tally(clima, UMBRAL_ACTIVACION);
    const N = clima.length;
    const acc = ((base.tp + base.tn) / N) * 100;
    const perdidaTotal = rend.reduce((s, r) => s + (+r.perdida_usd || 0), 0);
    const faTotal = base.fp * COSTO_NOCHE;
    const ratio = Math.round(perdidaTotal / faTotal);

    // Slide prices
    document.getElementById("p-fp-cost").textContent =
      "Una noche de protección ≈ " + esUSD(COSTO_NOCHE);
    document.getElementById("p-fn-cost").textContent =
      "La cosecha del sector ≈ " + esUSD(perdidaTotal);

    // Slide accuracy trap
    document.getElementById("accBig").textContent = acc.toFixed(0) + "%";
    const nonFrost = clima.filter((r) => r.temp_min_obs_c > UMBRAL_DANO).length;
    document.getElementById("dummyAcc").textContent =
      "~" + Math.round((nonFrost / N) * 100) + "%";
    const grid = document.getElementById("dotgrid");
    grid.innerHTML = "";
    clima.forEach((r) => {
      const d = document.createElement("div");
      d.className = "dot " + classify(r, UMBRAL_ACTIVACION);
      d.title = r.fecha + " · min " + esT(r.temp_min_obs_c);
      grid.appendChild(d);
    });

    // Slide 18-Jul
    const noche =
      clima.find((r) => r.fecha === "2025-07-18") ||
      clima.reduce((a, b) => (b.temp_min_obs_c < a.temp_min_obs_c ? b : a));
    document.getElementById("nf-pron").textContent =
      "+" + esT(noche.temp_min_pronostico_c);
    document.getElementById("nf-obs").textContent = esT(noche.temp_min_obs_c);
    document.getElementById("nf-err").textContent = (
      noche.temp_min_pronostico_c - noche.temp_min_obs_c
    ).toLocaleString("es-CL", {
      minimumFractionDigits: 1,
      maximumFractionDigits: 1,
    });

    // Resolved matrix
    document.getElementById("f-tp").textContent = base.tp;
    document.getElementById("f-tn").textContent = base.tn;
    document.getElementById("f-fp").textContent = base.fp;
    document.getElementById("f-fn").textContent = base.fn;
    document.getElementById("f-fp-c").textContent = esUSD(faTotal);
    document.getElementById("f-fn-c").textContent = esUSD(perdidaTotal);

    // store for lazy counters
    charts._loss = perdidaTotal;
    charts._fa = faTotal;
    charts._ratio = ratio;
  }

  function buildDial() {
    const slider = document.getElementById("thrSlider");
    const upd = () => {
      const thr = parseFloat(slider.value);
      document.getElementById("thrVal").textContent = thr.toLocaleString(
        "es-CL",
        { minimumFractionDigits: 1, maximumFractionDigits: 1 },
      );
      document.getElementById("kpi-thr").textContent =
        thr.toLocaleString("es-CL", {
          minimumFractionDigits: 1,
          maximumFractionDigits: 1,
        }) + " °C";
      const t = tally(clima, thr);
      document.getElementById("c-tp").textContent = t.tp;
      document.getElementById("c-fn").textContent = t.fn;
      document.getElementById("c-fp").textContent = t.fp;
      document.getElementById("c-tn").textContent = t.tn;
      const msg = document.getElementById("dial-msg");
      if (t.fn >= 2)
        msg.innerHTML =
          'Dial exigente: menos falsas alarmas, pero <span class="danger">más heladas se te escapan.</span> Cada escape puede costar millones.';
      else if (t.fp >= 6)
        msg.innerHTML =
          'Dial nervioso: cazas casi todas las heladas, al precio de <span class="warn">muchas falsas alarmas.</span> Baratas, pero se acumulan.';
      else
        msg.innerHTML =
          'Mover el dial <span class="accent">no elimina el error</span>: solo cambia <span class="accent">qué tipo</span> de error cometes.';
    };
    slider.addEventListener("input", upd);
    upd();
  }

  function buildTimeline() {
    const ctx = document.getElementById("timelineChart");
    const labels = clima.map((r) => r.fecha.slice(5));
    const obs = clima.map((r) => r.temp_min_obs_c);
    const pron = clima.map((r) => r.temp_min_pronostico_c);
    const idx = clima.findIndex((r) => r.fecha === "2025-07-18");
    const ptR = obs.map((_, i) => (i === idx ? 7 : 0));
    const ptC = obs.map((_, i) => (i === idx ? C.red : C.frost));
    charts.timeline = new Chart(ctx, {
      type: "line",
      data: {
        labels,
        datasets: [
          {
            label: "Mínima observada",
            data: obs,
            borderColor: C.frost,
            backgroundColor: C.frost,
            borderWidth: 2,
            tension: 0.3,
            pointRadius: ptR,
            pointBackgroundColor: ptC,
            pointBorderColor: ptC,
          },
          {
            label: "Pronóstico de mínima",
            data: pron,
            borderColor: C.mute,
            borderWidth: 1.5,
            borderDash: [5, 4],
            tension: 0.3,
            pointRadius: 0,
          },
          {
            label: "Umbral de activación (2 °C)",
            data: labels.map(() => UMBRAL_ACTIVACION),
            borderColor: C.amber,
            borderWidth: 1,
            borderDash: [2, 3],
            pointRadius: 0,
          },
          {
            label: "Umbral de daño (−0,5 °C)",
            data: labels.map(() => UMBRAL_DANO),
            borderColor: C.red,
            borderWidth: 1,
            borderDash: [2, 3],
            pointRadius: 0,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: !reduce,
        interaction: { intersect: false, mode: "index" },
        plugins: {
          legend: {
            labels: {
              color: C.mute,
              boxWidth: 12,
              font: { family: "IBM Plex Mono", size: 11 },
            },
          },
          tooltip: { callbacks: { title: (i) => "2025-" + i[0].label } },
        },
        scales: {
          x: {
            grid: { color: C.line },
            ticks: {
              color: C.mute,
              maxTicksLimit: 9,
              font: { family: "IBM Plex Mono", size: 10 },
            },
          },
          y: {
            grid: { color: C.line },
            ticks: {
              color: C.mute,
              callback: (v) => v + "°",
              font: { family: "IBM Plex Mono", size: 11 },
            },
          },
        },
      },
    });
  }

  function buildYield() {
    const ctx = document.getElementById("yieldChart");
    const labels = rend.map((r) => "Sector " + r.sector);
    const esp = rend.map((r) => r.rendimiento_esperado_kg);
    const real = rend.map((r) => r.rendimiento_real_kg);
    const realColors = rend.map((r) =>
      r.dano_helada_pct > 0 ? C.red : C.frost,
    );
    charts.yield = new Chart(ctx, {
      type: "bar",
      data: {
        labels,
        datasets: [
          {
            label: "Esperado",
            data: esp,
            backgroundColor: "rgba(138,154,176,.28)",
            borderRadius: 4,
          },
          {
            label: "Real",
            data: real,
            backgroundColor: realColors,
            borderRadius: 4,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: !reduce,
        plugins: {
          legend: {
            labels: {
              color: C.mute,
              boxWidth: 12,
              font: { family: "IBM Plex Mono", size: 11 },
            },
          },
          tooltip: {
            callbacks: {
              label: (c) =>
                c.dataset.label +
                ": " +
                c.parsed.y.toLocaleString("es-CL") +
                " kg",
            },
          },
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              color: C.mute,
              font: { family: "IBM Plex Mono", size: 10 },
            },
          },
          y: {
            grid: { color: C.line },
            ticks: {
              color: C.mute,
              callback: (v) => v / 1000 + "t",
              font: { family: "IBM Plex Mono", size: 11 },
            },
          },
        },
      },
    });
  }

  /* ---------- deck navigation ---------- */
  const slides = [...document.querySelectorAll(".slide")];
  const lossIdx = slides.findIndex((s) => s.dataset.section === "La cuenta");
  let cur = 0,
    lossDone = false,
    mapObj = null;

  /* ---------- Power BI: sidebar ---------- */
  function buildSidebar() {
    const nav = document.getElementById("sidebar");
    slides.forEach((s, i) => {
      const btn = document.createElement("button");
      btn.className = "sb-item";
      btn.innerHTML =
        '<span class="sb-dot"></span><span class="sb-label">' +
        (s.dataset.section || "") +
        "</span>";
      btn.addEventListener("click", () => show(i));
      btn.setAttribute("aria-label", s.dataset.section || "Slide " + (i + 1));
      nav.appendChild(btn);
    });
  }
  function updateSidebar() {
    const items = document.querySelectorAll(".sb-item");
    items.forEach((el, i) => el.classList.toggle("active", i === cur));
  }
  function updateKPI() {
    const base = tally(clima, UMBRAL_ACTIVACION);
    const N = clima.length;
    const acc = ((base.tp + base.tn) / N) * 100;
    const perdida = rend.reduce((s, r) => s + (+r.perdida_usd || 0), 0);
    const fa = base.fp * COSTO_NOCHE;
    const ratio = Math.round(perdida / fa);
    document.getElementById("kpi-acc").textContent = acc.toFixed(0) + "%";
    document.getElementById("kpi-fn").textContent = base.fn;
    document.getElementById("kpi-loss").textContent = esUSD(perdida);
    document.getElementById("kpi-ratio").textContent = ratio + "×";
    document.getElementById("kpi-thr").textContent =
      UMBRAL_ACTIVACION.toLocaleString("es-CL", {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1,
      }) + " °C";
  }

  function buildMap() {
    if (mapObj || typeof L === "undefined") return;
    const campo = [-30.03, -70.71];
    mapObj = L.map("mapEl", {
      scrollWheelZoom: false,
      attributionControl: true,
    }).setView(campo, 9);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 17,
      attribution: "&copy; OpenStreetMap",
    }).addTo(mapObj);
    const dot = L.circleMarker(campo, {
      radius: 9,
      color: "#67E8F9",
      weight: 2,
      fillColor: "#FB4A5A",
      fillOpacity: 0.95,
    }).addTo(mapObj);
    dot
      .bindPopup(
        "<b>Campo de fresa (caso)</b><br>Valle del Elqui · 30,03° S, 70,71° O<br>Noche crítica: 18-jul-2025, mínima −1,6 °C",
      )
      .openPopup();
    L.circle(campo, {
      radius: 2500,
      color: "#67E8F9",
      weight: 1,
      fillColor: "#67E8F9",
      fillOpacity: 0.08,
      dashArray: "4 4",
    }).addTo(mapObj);
  }
  document.getElementById("totNum").textContent = slides.length;

  function show(i) {
    cur = Math.max(0, Math.min(slides.length - 1, i));
    slides.forEach((s, k) => s.classList.toggle("active", k === cur));
    const isDark = slides[cur].classList.contains("dark");
    document.body.classList.toggle("dark-active", isDark);
    document.getElementById("curNum").textContent = cur + 1;
    document.getElementById("progress").style.width =
      (cur / (slides.length - 1)) * 100 + "%";
    document.getElementById("sectionTag").textContent =
      slides[cur].dataset.section || "";
    updateSidebar();

    // Dynamic Chart.js color theme update
    const textColor = isDark ? "#FFFFFF" : "#000000";
    const gridColor = isDark ? "#262626" : "#E2E2E2";

    if (charts.timeline) {
      charts.timeline.options.scales.x.ticks.color = textColor;
      charts.timeline.options.scales.x.grid.color = gridColor;
      charts.timeline.options.scales.y.ticks.color = textColor;
      charts.timeline.options.scales.y.grid.color = gridColor;
      charts.timeline.options.plugins.legend.labels.color = textColor;

      // Dataset colors
      const ds = charts.timeline.data.datasets;
      ds[0].borderColor = isDark ? "#67E8F9" : "#000000";
      ds[0].backgroundColor = isDark ? "#67E8F9" : "#000000";
      ds[1].borderColor = isDark ? "#A3A3A3" : "#737373";
      ds[2].borderColor = isDark ? "#FBBF24" : "#D97706";
      ds[3].borderColor = isDark ? "#FB4A5A" : "#DC2626";

      // Point highlight color for 18-Jul
      const idx = clima.findIndex((r) => r.fecha === "2025-07-18");
      if (idx !== -1) {
        ds[0].pointBackgroundColor = ds[0].pointBackgroundColor.map((_, i) =>
          i === idx
            ? isDark
              ? "#FB4A5A"
              : "#DC2626"
            : isDark
              ? "#67E8F9"
              : "#000000",
        );
        ds[0].pointBorderColor = ds[0].pointBorderColor.map((_, i) =>
          i === idx
            ? isDark
              ? "#FB4A5A"
              : "#DC2626"
            : isDark
              ? "#67E8F9"
              : "#000000",
        );
      }

      charts.timeline.update();
    }
    if (charts.yield) {
      charts.yield.options.scales.x.ticks.color = textColor;
      charts.yield.options.scales.y.ticks.color = textColor;
      charts.yield.options.scales.y.grid.color = gridColor;
      charts.yield.options.plugins.legend.labels.color = textColor;

      // Dataset colors
      const ds = charts.yield.data.datasets;
      ds[0].backgroundColor = isDark
        ? "rgba(255,255,255,.2)"
        : "rgba(0,0,0,.15)";
      ds[1].backgroundColor = rend.map((r) =>
        r.dano_helada_pct > 0
          ? isDark
            ? "#FB4A5A"
            : "#DC2626"
          : isDark
            ? "#67E8F9"
            : "#000000",
      );

      charts.yield.update();
    }

    // resize charts when their slide appears
    if (charts.timeline) charts.timeline.resize();
    if (charts.yield) charts.yield.resize();
    // map slide: build/refresh when visible
    if (slides[cur].dataset.section === "El lugar") {
      buildMap();
      setTimeout(() => mapObj && mapObj.invalidateSize(), 350);
    }
    // fire the loss counter when reaching "La cuenta"
    if (cur === lossIdx && !lossDone) {
      lossDone = true;
      countUp(document.getElementById("lossNum"), charts._loss, esUSD);
      countUp(document.getElementById("faTotal"), charts._fa, esUSD, 900);
      document.getElementById("ratioNum").textContent = charts._ratio + "×";
    }
  }

  const next = () => show(cur + 1),
    prev = () => show(cur - 1);
  document.getElementById("nextBtn").onclick = next;
  document.getElementById("prevBtn").onclick = prev;
  window.addEventListener("keydown", (e) => {
    if (["ArrowRight", "PageDown", " "].includes(e.key)) {
      e.preventDefault();
      next();
    } else if (["ArrowLeft", "PageUp"].includes(e.key)) {
      e.preventDefault();
      prev();
    } else if (e.key === "Home") show(0);
    else if (e.key === "End") show(slides.length - 1);
    else if (e.key === "f" || e.key === "F") {
      if (!document.fullscreenElement)
        document.documentElement.requestFullscreen();
      else document.exitFullscreen();
    }
  });

  // touch swipe
  let tx = 0;
  window.addEventListener("touchstart", (e) => (tx = e.touches[0].clientX), {
    passive: true,
  });
  window.addEventListener(
    "touchend",
    (e) => {
      const dx = e.changedTouches[0].clientX - tx;
      if (Math.abs(dx) > 50) {
        dx < 0 ? next() : prev();
      }
    },
    { passive: true },
  );

  function setupInteractivity() {
    // Matrix Cell click handlers
    document.querySelectorAll(".matrix .cell").forEach((cell) => {
      cell.style.cursor = "pointer";
      cell.addEventListener("click", () => {
        const slide = cell.closest(".slide");
        let detailBox = slide.querySelector(".matrix-detail-box");
        if (!detailBox) {
          detailBox = document.createElement("div");
          detailBox.className = "matrix-detail-box";
          detailBox.style.cssText =
            "margin-top: 1rem; border: 1px solid var(--line-light); padding: 12px 18px; font-size: 0.82rem; background: var(--bg-light-panel); transition: all 0.3s; line-height: 1.45;";

          // Try to insert before chart-note or at end of slide
          const refNode =
            slide.querySelector(".chart-note") ||
            slide.querySelector(".lead:last-of-type");
          if (refNode) {
            slide.insertBefore(detailBox, refNode);
          } else {
            slide.appendChild(detailBox);
          }
        }

        let type = "";
        if (cell.classList.contains("tp")) type = "tp";
        else if (cell.classList.contains("fp")) type = "fp";
        else if (cell.classList.contains("fn")) type = "fn";
        else if (cell.classList.contains("tn")) type = "tn";

        const details = {
          tp: '<b>Acierto Operativo (TP):</b> El modelo predijo helada y ocurrió. Se activó la aspersión a tiempo, salvando la floración. <span style="color:var(--accent-green); font-weight:700;">Resultado: Cosecha salvada</span> con un costo de operación de US$ 340.',
          fp: '<b>Falsa Alarma (FP - Error Tipo I):</b> El modelo predijo helada pero no ocurrió. Se activó la aspersión innecesariamente. <span style="color:var(--accent-amber); font-weight:700;">Resultado: Gasto innecesario de US$ 340</span> en agua y energía. Cultivo intacto.',
          fn: '<b>Amenaza No Detectada (FN - Error Tipo II):</b> El modelo predijo noche segura pero heló. Los aspersores quedaron apagados. <span style="color:var(--accent-red); font-weight:700;">Resultado: US$ 56.160 en pérdidas directas</span> (el Sector D completo congelado).',
          tn: '<b>Negativo Correcto (TN):</b> El modelo predijo noche segura y no heló. Los aspersores se mantuvieron apagados de forma correcta. <span style="color:var(--accent-green); font-weight:700;">Resultado: Operación óptima con costo US$ 0</span>.',
        };

        detailBox.innerHTML = details[type] || "";
        detailBox.style.display = "block";

        slide.querySelectorAll(".matrix .cell").forEach((c) => {
          c.style.outline = "none";
          c.style.transform = "none";
        });
        cell.style.outline = "2px solid var(--accent-frost)";
        cell.style.transform = "scale(0.99)";
      });
    });

    // Process Card click handlers
    document.querySelectorAll(".process-card").forEach((card) => {
      card.style.cursor = "pointer";
      card.addEventListener("click", () => {
        const slide = card.closest(".slide");
        let detailBox = slide.querySelector(".process-detail-box");
        if (!detailBox) {
          detailBox = document.createElement("div");
          detailBox.className = "process-detail-box";
          detailBox.style.cssText =
            "margin-top: 1.2rem; border: 1px solid var(--line-light); padding: 12px 18px; font-size: 0.85rem; background: var(--bg-light-panel); transition: all 0.3s; line-height: 1.45;";
          slide.appendChild(detailBox);
        }

        const step = card.querySelector(".step-num").textContent;
        const tips = {
          "01": "<b>Tip del Contexto:</b> Antes de diseñar gráficos, define a la persona clave que tomará la decisión. Si presentas al Gerente Agrícola, concéntrate en las heladas capturadas y los sensores locales.",
          "02": "<b>Tip de Visualización:</b> Elige el gráfico según el mensaje. Usa líneas para series temporales (temperaturas) y barras asimétricas para comparar pérdidas (cero aspersión vs. falsa alarma).",
          "03": "<b>Tip de Limpieza:</b> Quita todo lo redundante. Elimina grillas oscuras, bordes 3D y leyendas que saturen el espacio visual. Menos es más.",
          "04": "<b>Tip de Atención:</b> Dirige la vista del lector usando atributos preatentivos. Usa rojo solo para destacar pérdidas críticas (US$ 56.160) o fallos graves.",
          "05": "<b>Tip de Diseño:</b> Mantén una cuadrícula rígida sin esquinas redondeadas. El espacio negativo y la alineación perfecta aumentan la credibilidad técnica.",
          "06": "<b>Tip de Narrativa:</b> Crea un conflicto. En este caso: la noche helada del 18 de julio donde todo parecía seguro. Y luego propón la resolución (salvaguardas).",
        };

        detailBox.innerHTML = tips[step] || "";
        detailBox.style.display = "block";

        slide.querySelectorAll(".process-card").forEach((c) => {
          c.style.outline = "none";
          c.style.background = "#FFFFFF";
        });
        card.style.outline = "1px solid var(--text-light-main)";
        card.style.background = "var(--bg-light-panel)";
      });
    });
  }

  /* ---------- init ---------- */
  (async function () {
    Chart.defaults.color = C.mute;
    Chart.defaults.font.family = "IBM Plex Sans";

    // Fetch data using relative path (hosted in public/)
    clima = await loadCSV("./data/clima_valle_elqui.csv");
    rend = await loadCSV("./data/rendimiento_fresa.csv");

    clima = clima.filter((r) => r && r.fecha);
    rend = rend.filter((r) => r && r.sector);

    buildSidebar();
    buildStatics();
    updateKPI();
    buildDial();
    buildTimeline();
    buildYield();
    setupInteractivity();
    show(0);
  })();
</script>

