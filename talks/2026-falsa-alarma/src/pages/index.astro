  /* ---------- Charts (Scientific blueprint) ---------- */
  .chart-box {
    position: relative;
    min-height: 200px;
    max-height: 60vh;
    margin-top: 1rem;
    border: 1px solid var(--line-light);
    padding: 18px 24px;
    background: #ffffff;
    overflow: hidden;
    flex: 0 1 auto;
  }
  .chart-box.chart-large {
    min-height: min(55vh, 420px);
    max-height: none;
  }
  .slide.dark .chart-box {
    border-color: var(--line-dark);
    background: #000000;
  }
  .chart-note {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    color: var(--text-light-faint);
    margin-top: 8px;
  }
  .slide.dark .chart-note {
    color: var(--text-dark-faint);
  }

  /* ---------- Night flow (Mathematical Style) ---------- */
  .flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    margin-top: 1rem;
  }
  .flow-step {
    border: 1px solid var(--line-light);
    padding: 24px;
    text-align: center;
    background: var(--bg-light-panel);
  }
  .slide.dark .flow-step {
    border-color: var(--line-dark);
    background: var(--bg-dark-panel);
  }
  .flow-step .tag {
    margin-bottom: 0.5rem;
    display: block;
    font-size: 0.68rem;
    color: var(--text-light-faint);
  }
  .slide.dark .flow-step .tag {
    color: var(--text-dark-faint);
  }
  .flow-step .sub {
    color: var(--text-light-mute);
    font-size: 0.84rem;
    margin-top: 0.5rem;
  }
  .slide.dark .flow-step .sub {
    color: var(--text-dark-mute);
  }
  .arrow {
    font-family: "IBM Plex Mono", monospace;
    color: var(--text-light-faint);
    font-size: 1.5rem;
  }
  .slide.dark .arrow {
    color: var(--text-dark-faint);
  }

  /* ---------- Climax Flow (Slide 13) ---------- */
  .climax-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: stretch;
    gap: 0;
    margin-top: 1.2rem;
  }
  .climax-step {
    border: 1px solid var(--line-dark);
    background: var(--bg-dark-panel);
    padding: 28px 20px 20px;
    text-align: center;
    position: relative;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .climax-safe { border-top: 3px solid var(--accent-green); }
  .climax-decision { border-top: 3px solid #FFFFFF; background: #1a1a2e; }
  .climax-danger { border-top: 3px solid var(--accent-red); }

  .climax-num {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg-dark);
    border: 2px solid var(--line-dark);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dark-mute);
  }
  .climax-safe .climax-num { border-color: var(--accent-green); color: var(--accent-green); }
  .climax-decision .climax-num { border-color: #FFFFFF; color: #FFFFFF; }
  .climax-danger .climax-num { border-color: var(--accent-red); color: var(--accent-red); }

  .climax-icon {
    font-size: 1.6rem;
    margin-bottom: 0.4rem;
    filter: grayscale(0.2);
  }

  .climax-step .tag {
    margin-bottom: 0.5rem;
    display: block;
    font-size: 0.68rem;
    color: var(--text-dark-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .climax-step .sub {
    color: var(--text-dark-mute);
    font-size: 0.82rem;
    margin-top: 0.6rem;
    line-height: 1.5;
  }

  .climax-badge {
    margin-top: auto;
    padding-top: 0.8rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .climax-badge-ok { color: var(--accent-green); }
  .climax-badge-warn { color: #FFFFFF; }
  .climax-badge-danger { color: var(--accent-red); }

  .climax-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    position: relative;
  }
  .climax-line {
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-green) 0%, #FFFFFF 50%, var(--accent-red) 100%);
    opacity: 0.5;
  }
  .climax-arrow {
    position: absolute;
    font-size: 0.7rem;
    color: var(--text-dark-faint);
    background: var(--bg-dark);
    padding: 2px 4px;
  }

  .climax-error-bar {
    margin-top: 1.4rem;
    padding: 12px 20px;
    background: rgba(251, 74, 90, 0.08);
    border-left: 3px solid var(--accent-red);
    border-radius: 0 4px 4px 0;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .climax-error-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent-red);
    text-transform: uppercase;
  }
  .climax-error-val {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-red);
  }
  .climax-error-note {
    color: var(--text-dark-mute);
    font-size: 0.88rem;
  }

  /* ---------- Big Loss Layout (Asymmetrical split) ---------- */
  .loss-layout {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .loss-num {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 700;
    color: var(--accent-red);
    font-size: clamp(3rem, 6.5vw, 5.8rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .compare-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 1.5rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--line-light);
    padding-top: 12px;
  }
  .slide.dark .compare-row {
    border-color: var(--line-dark);
  }
  .vs-chip {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.84rem;
    color: var(--text-light-mute);
  }
  .slide.dark .vs-chip {
    color: var(--text-dark-mute);
  }
  .ratio {
    font-family: "Inter", sans-serif;
    font-weight: 700;
    color: var(--accent-amber);
    font-size: 1.6rem;
  }

  /* ---------- Safeguards (Minimal Cards) ---------- */
  .safeguard-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 1rem;
  }
  .sg-card {
    border: 1px solid var(--line-light-faint);
    padding: 18px 22px;
    background: var(--bg-light-panel);
    position: relative;
  }
  .sg-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
  }
  .sg-card.sg-blue::before {
    background: var(--accent-frost);
  }
  .sg-card.sg-amber::before {
    background: var(--accent-amber);
  }
  .sg-card.sg-green::before {
    background: var(--accent-green);
  }
  .sg-card.sg-red::before {
    background: var(--accent-red);
  }
  .sg-num {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 700;
    font-size: 0.72rem;
    color: var(--text-light-faint);
    margin-bottom: 4px;
  }
  .sg-card h3 {
    font-size: 1.1rem;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .sg-card p {
    font-size: 0.82rem;
    color: var(--text-light-mute);
    line-height: 1.45;
  }
  .sg-card .sg-cost {
    margin-top: 8px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.74rem;
    color: var(--text-light-faint);
    border-top: 1px solid var(--line-light-faint);
    padding-top: 6px;
  }
  .sg-card .sg-cost b {
    color: var(--text-light-main);
  }

  /* ---------- Vertical Timeline (Storytelling axis) ---------- */
  .stl-flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 1.5rem;
    border-top: 1px solid var(--line-light);
    border-bottom: 1px solid var(--line-light);
    padding: 1.5rem 0;
  }
  .stl-step {
    padding: 0 16px;
    border-right: 1px solid var(--line-light-faint);
    position: relative;
  }
  .stl-step:last-child {
    border-right: none;
  }
  .stl-step .stl-num {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--text-light-main);
    margin-bottom: 6px;
    display: block;
  }
  .stl-step .stl-label {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .stl-step .stl-desc {
    font-size: 0.78rem;
    color: var(--text-light-mute);
    line-height: 1.45;
  }

  /* ---------- Universality (3 columns) ---------- */
  .three {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 1rem;
  }
  .u-card {
    border: 1px solid var(--line-light);
    padding: 24px;
    background: #ffffff;
  }
  .u-card h3 {
    font-size: 1.25rem;
    text-transform: uppercase;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line-light);
    padding-bottom: 6px;
  }
  .u-row {
    margin: 8px 0;
    font-size: 0.85rem;
    color: var(--text-light-mute);
    line-height: 1.45;
  }
  .u-row b {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 700;
    font-size: 0.74rem;
    text-transform: uppercase;
    color: var(--text-light-main);
    display: block;
    margin-bottom: 2px;
  }
  .u-row.fa b {
    color: var(--accent-amber);
  }
  .u-row.mt b {
    color: var(--accent-red);
  }

  /* ---------- Closing slide ---------- */
  .closing h1 {
    font-size: clamp(2rem, 5vw, 4.2rem);
    max-width: 25ch;
  }
  .callback {
    font-family: "Inter", sans-serif;
    font-weight: 400;
    color: var(--text-dark-main);
    font-size: clamp(1.2rem, 2.2vw, 1.8rem);
    margin-top: 2rem;
    max-width: 38ch;
    line-height: 1.45;
  }

  /* ---------- Chrome elements (Power BI Look monochrome) ---------- */
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--text-light-main);
    z-index: 20;
    width: 0;
    transition: width 0.3s ease;
  }
  body.dark-active .progress {
    background: var(--text-dark-main);
  }

  .chrome {
    position: fixed;
    bottom: 18px;
    left: 76px;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.76rem;
    color: var(--text-light-faint);
    transition: left 0.3s ease;
  }
  .sidebar:hover ~ .chrome {
    left: 200px;
  }
  body.dark-active .chrome {
    color: var(--text-dark-faint);
  }
  .counter b {
    color: var(--text-light-main);
    font-weight: 700;
  }
  body.dark-active .counter b {
    color: var(--text-dark-main);
  }

  .navbtn {
    background: #ffffff;
    border: 1px solid var(--line-light);
    color: var(--text-light-main);
    width: 34px;
    height: 34px;
    cursor: pointer;
    font-size: 0.9rem;
    display: grid;
    place-items: center;
    transition: background 0.2s;
  }
  body.dark-active .navbtn {
    background: #000000;
    border-color: var(--line-dark);
    color: var(--text-dark-main);
  }
  .navbtn:hover {
    background: var(--bg-light-panel);
  }
  body.dark-active .navbtn:hover {
    background: var(--bg-dark-panel);
  }

  .section-tag {
    position: fixed;
    bottom: 20px;
    right: 22px;
    z-index: 20;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-light-faint);
  }
  body.dark-active .section-tag {
    color: var(--text-dark-faint);
  }

  .hint {
    position: absolute;
    bottom: calc(var(--stage-pad) + 50px);
    left: var(--stage-pad);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    color: var(--text-light-faint);
    letter-spacing: 0.1em;
  }
  .slide.dark .hint {
    color: var(--text-dark-faint);
  }

  /* ---------- Sidebar Nav ---------- */
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 56px;
    z-index: 30;
    background: #ffffff;
    border-right: 1px solid var(--line-light);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px 0;
    gap: 2px;
    transition: width 0.3s ease;
  }
  body.dark-active .sidebar {
    background: #000000;
    border-right-color: var(--line-dark);
  }
  .sidebar:hover {
    width: 180px;
  }
  .sidebar-logo {
    width: 32px;
    height: 32px;
    margin-bottom: 16px;
    flex-shrink: 0;
    background: #000000;
    display: grid;
    place-items: center;
    font-family: "Inter", sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: #ffffff;
  }
  body.dark-active .sidebar-logo {
    background: #ffffff;
    color: #000000;
  }
  .sidebar:hover .sidebar-logo {
    width: calc(100% - 24px);
  }
  .sb-item {
    width: 100%;
    padding: 8px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    border: none;
    background: none;
    color: var(--text-light-faint);
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    transition:
      color 0.2s,
      background 0.2s;
  }
  body.dark-active .sb-item {
    color: var(--text-dark-faint);
  }
  .sb-item:hover {
    color: var(--text-light-main);
    background: var(--bg-light-panel);
  }
  body.dark-active .sb-item:hover {
    color: var(--text-dark-main);
    background: var(--bg-dark-panel);
  }
  .sb-item.active {
    color: var(--text-light-main);
    font-weight: 700;
  }
  body.dark-active .sb-item.active {
    color: var(--text-dark-main);
  }
  .sb-dot {
    width: 4px;
    height: 4px;
    background: var(--text-light-faint);
    flex-shrink: 0;
    transition:
      transform 0.2s,
      background 0.2s;
  }
  body.dark-active .sb-dot {
    background: var(--text-dark-faint);
  }
  .sb-item.active .sb-dot {
    background: var(--text-light-main);
    transform: scale(1.5);
  }
  body.dark-active .sb-item.active .sb-dot {
    background: var(--text-dark-main);
  }
  .sb-label {
    opacity: 0;
    transition: opacity 0.2s;
    text-transform: uppercase;
  }
  .sidebar:hover .sb-label {
    opacity: 1;
  }

  /* ---------- KPI Bar ---------- */
  .kpi-bar {
    position: fixed;
    top: 0;
    left: 56px;
    right: 0;
    height: 40px;
    z-index: 25;
    background: #ffffff;
    border-bottom: 1px solid var(--line-light);
    display: flex;
    align-items: center;
    padding: 0 24px;
    gap: 24px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    transition: left 0.3s ease;
  }
  body.dark-active .kpi-bar {
    background: #000000;
    border-bottom-color: var(--line-dark);
  }
  .sidebar:hover ~ .kpi-bar {
    left: 180px;
  }
  .kpi {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .kpi-val {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--text-light-main);
  }
  body.dark-active .kpi-val {
    color: var(--text-dark-main);
  }
  .kpi-lbl {
    color: var(--text-light-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  body.dark-active .kpi-lbl {
    color: var(--text-dark-faint);
  }
  .kpi-sep {
    width: 1px;
    height: 16px;
    background: var(--line-light-faint);
  }
  body.dark-active .kpi-sep {
    background: var(--line-dark-faint);
  }

  /* ---------- Slide specific style overlays ---------- */
  .slide.dark {
    background: var(--bg-dark);
    color: var(--text-dark-main);
  }
  .slide.dark .readout {
    color: #ffffff !important;
  }
  .slide.dark .readout.cold {
    color: var(--accent-red) !important;
  }
  .slide.dark .readout.warn {
    color: var(--accent-amber) !important;
  }
  .slide.dark .readout.safe {
    color: var(--text-dark-main) !important;
  }
  .slide.dark .card {
    border-color: var(--line-dark);
    background: var(--bg-dark-panel);
  }
  .slide.dark .card h3 {
    color: #ffffff;
  }

  /* ---------- Cost Layout ---------- */
  .cost-layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 24px;
    margin-top: 1rem;
    align-items: start;
  }
  .cost-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cost-card {
    border: 2px solid var(--line-dark);
    padding: 24px;
    background: var(--bg-dark-panel);
  }
  .cost-loss {
    border-top: 4px solid var(--accent-red);
  }
  .cost-false {
    border-top: 4px solid var(--accent-amber);
  }
  .cost-icon {
    font-size: 2.5rem;
    margin-bottom: 12px;
  }
  .cost-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }
  .cost-label {
    font-size: 0.7rem;
    color: var(--text-dark-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .cost-name {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .cost-loss .cost-name {
    color: var(--accent-red);
  }
  .cost-false .cost-name {
    color: var(--accent-amber);
  }
  .cost-amount {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .cost-card p {
    font-size: 0.85rem;
    color: var(--text-dark-mute);
    line-height: 1.5;
  }
  .cost-divider {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cost-divider span {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-dark-faint);
    background: var(--bg-dark);
    padding: 6px 10px;
    border: 1px solid var(--line-dark);
  }

  /* ---------- Error Comparison ---------- */
  .error-comparison {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    margin-top: 1.5rem;
    align-items: stretch;
  }
  .error-card {
    border: 2px solid var(--line-light);
    padding: 24px;
    background: #ffffff;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .error-type1 {
    border-top: 4px solid var(--accent-amber);
  }
  .error-type2 {
    border-top: 4px solid var(--accent-red);
  }
  .error-icon {
    font-size: 2.5rem;
    margin-bottom: 12px;
  }
  .error-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 12px;
  }
  .error-label {
    font-size: 0.65rem;
    color: var(--text-light-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .error-name {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .error-type1 .error-name {
    color: var(--accent-amber);
  }
  .error-type2 .error-name {
    color: var(--accent-red);
  }
  .error-card h3 {
    text-transform: uppercase;
    font-size: 1.1rem;
    margin-bottom: 0.8rem;
    line-height: 1.3;
  }
  .error-card p {
    font-size: 0.85rem;
    color: var(--text-light-mute);
    line-height: 1.6;
    flex: 1;
  }
  .error-verdict {
    font-family: "IBM Plex Mono", monospace;
    font-size: 1rem;
    font-weight: 700;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--line-light);
    color: var(--accent-amber);
  }
  .error-verdict.danger {
    color: var(--accent-red);
  }
  .error-divider {
    display: flex;
    align-items: center;
